# ============================================================================
# Finora — environment variables
# ============================================================================
# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
# IMPORTANT: this file documents two separate sets of values.
#
#   CLIENT values are compiled into the Flutter app with --dart-define. They
#   ship inside the installed binary, so only values that are safe to publish
#   may appear there.
#
#   SERVER values are set as Supabase Edge Function secrets. They never reach
#   the app. Putting an OCR key or a service-role key in the client section
#   would publish it to every user who installs the app.
# ============================================================================


# ----------------------------------------------------------------------------
# CLIENT — passed to Flutter with --dart-define
# ----------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# The publishable (anon) key. Safe to ship: it grants only what Row Level
# Security allows the anon and authenticated roles, which is nothing until a
# user signs in and then only their own rows.
SUPABASE_ANON_KEY=

# Optional client overrides. Defaults in brackets.
# OCR_FUNCTION_NAME=ocr-process      [ocr-process]
# MAX_UPLOAD_MB=15                   [15]
# MAX_PDF_PAGES=30                   [30]


# ----------------------------------------------------------------------------
# SERVER — set with `supabase secrets set`, never with --dart-define
# ----------------------------------------------------------------------------

# Which OCR provider to use: google | azure | aws
OCR_PROVIDER=google

# Google Cloud Vision. Handles images; synchronous Vision cannot read PDFs, so
# scanned PDFs need Azure. Text-layer PDFs work with any provider because they
# are read directly without OCR.
GOOGLE_VISION_API_KEY=

# Azure AI Document Intelligence. The option to choose if scanned, multi-page
# PDF statements matter: it reads PDFs natively.
AZURE_DOCUMENT_ENDPOINT=
AZURE_DOCUMENT_KEY=

# AWS Textract. Synchronous Textract accepts single-page PDFs only.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional server tuning. Defaults in brackets.
# OCR_MAX_PAGES=30                   [30]
# OCR_MAX_BYTES=15728640             [15 MB]
# OCR_TIMEOUT_MS=60000               [60s]
# OCR_DEFAULT_CURRENCY=LKR           [LKR]

# Injected automatically by Supabase into every function. Do not set these
# yourself, and never copy SUPABASE_SERVICE_ROLE_KEY anywhere near the client:
# it bypasses Row Level Security entirely.
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
